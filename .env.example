# Configuration de base
PORT=3001
NODE_ENV=development

# Configuration Google Gemini AI
# Obtenez votre clé API sur: https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here

# Configuration du scheduler
SCHEDULER_ENABLED=true
TIMEZONE=UTC

# Configuration des rapports PDF
PDF_OUTPUT_DIR=uploads
PDF_BRAND_NAME="Helix Terminal"
PDF_LOGO_PATH="/path/to/logo.png"

# Configuration des notifications
NOTIFICATION_ENABLED=true
MAX_NOTIFICATIONS=100

# Configuration de nettoyage automatique
CLEANUP_ENABLED=true
CLEANUP_DAYS_OLD=30